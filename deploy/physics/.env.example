# Server path containing question-bank/, original papers, and _state/family/.
PHYSICS_DATA_DIR=/srv/aitutor-data/physics
# Default: private deployment, access via SSH tunnel.
BIND_ADDRESS=127.0.0.1
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# For a domain with DNS pointing to the server, use:
# BIND_ADDRESS=0.0.0.0
# SITE_ADDRESS=physics.example.com
# HTTP_PORT=80
# HTTPS_PORT=443
